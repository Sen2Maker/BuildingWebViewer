import java.io.*;import java.nio.file.*;import java.util.*;import java.security.MessageDigest;
public class RecoveryOwnershipRegression {
 static class Uri { final File file; Uri(File f){file=f;} }
 static class Intent { static final String ACTION_CREATE_DOCUMENT="create",CATEGORY_OPENABLE="open",EXTRA_TITLE="title"; Uri uri; Intent(){} Intent(String a){} Intent setType(String t){return this;} Intent addCategory(String c){return this;} Intent putExtra(String k,String v){return this;} Uri getData(){return uri;} Intent data(File f){uri=new Uri(f);return this;} }
 static class Bundle {final Map<String,Object> values=new HashMap<>(); Object get(String k){return values.get(k);}void putString(String k,String v){values.put(k,v);} }
 static class ParcelFileDescriptor { final File file; ParcelFileDescriptor(File f){file=f;} static class AutoCloseOutputStream extends FileOutputStream { AutoCloseOutputStream(ParcelFileDescriptor d)throws IOException{super(d.file);} } }
 static class Resolver { int opens;boolean fail,corrupt; ParcelFileDescriptor openFileDescriptor(Uri u,String mode)throws IOException{opens++;if(fail)throw new IOException("synthetic provider failure");return new ParcelFileDescriptor(u.file);} InputStream openInputStream(Uri u)throws IOException{return corrupt?new ByteArrayInputStream(new byte[]{0}):new FileInputStream(u.file);} }
 static class ProjectStore { int backups;boolean fail;File last; File backup(String id,File dir)throws IOException{backups++;if(fail)throw new IOException("synthetic backup failure");dir.mkdirs();last=new File(dir,id+".zip");Files.writeString(last.toPath(),id);return last;} }
 static class Queue { final ArrayDeque<Runnable> q=new ArrayDeque<>();boolean shut,reject; void execute(Runnable r){if(shut||reject)throw new java.util.concurrent.RejectedExecutionException();q.add(r);} void drain(){while(!q.isEmpty())q.remove().run();}void shutdown(){shut=true;} }
 static class Base { protected void onActivityResult(int a,int b,Intent c){}protected void onSaveInstanceState(Bundle b){}public void onDestroy(){} }
 static class Recovery extends Base {
 @@FIELDS@@
 static final int RESULT_OK=-1;
 final Queue io=new Queue(),ui=new Queue();final Resolver resolver=new Resolver();final File cache;boolean busy,destroyed,finishing;boolean launchFail;int launches,lastRequest;final List<String> notes=new ArrayList<>();
 Recovery(File dir){cache=dir;}File getCacheDir(){return cache;}boolean isFinishing(){return finishing;}boolean isDestroyed(){return destroyed;}void runOnUiThread(Runnable r){ui.execute(r);}void note(String s){notes.add(s);}void startActivityForResult(Intent i,int r){launches++;lastRequest=r;if(launchFail)throw new IllegalStateException("synthetic uncertain launch");}Resolver getContentResolver(){return resolver;}
 void pump(){io.drain();ui.drain();}Bundle save(){Bundle b=new Bundle();onSaveInstanceState(b);return b;}
 @@METHODS@@
 }
 static int assertions,cases;static void check(boolean b,String m){assertions++;if(!b)throw new AssertionError(m);}interface Test{void run()throws Exception;}static void test(String name,Test t)throws Exception{t.run();cases++;System.out.println("PASS "+name);}static File root;static Recovery fresh(){return new Recovery(root);}static ProjectStore store(){return new ProjectStore();}static File destination()throws IOException{return Files.createTempFile(root.toPath(),"destination-",".zip").toFile();}static Intent at(File f){return new Intent().data(f);}static Recovery started(ProjectStore s,String id){Recovery r=fresh();r.prepareBackup(s,id);r.pump();return r;}
 public static void main(String[]args)throws Exception {
 root=Files.createTempDirectory("recovery-regression-").toFile();
 test("busy preparation and waiting reject replacement",()->{ProjectStore s=store();Recovery r=fresh();r.prepareBackup(s,"A");r.prepareBackup(s,"B");r.pump();r.prepareBackup(s,"B");check(s.backups==1&&r.launches==1&&r.busy,"one owner");});
 test("happy write immutable file and verified readback",()->{ProjectStore s=store();Recovery r=started(s,"A");File d=destination();r.onActivityResult(r.lastRequest,-1,at(d));r.prepareBackup(s,"B");check(r.busy&&s.backups==1,"writer keeps slot");r.pump();check(Files.readString(d.toPath()).equals("A"),"correct bytes");check(!r.busy&&r.pendingBackup==null&&s.last.exists(),"settled and backup retained");check(r.notes.stream().anyMatch(n->n.startsWith("Export copy readback verified")),"verified");});
 test("cancel and null results retain backup",()->{for(int variant=0;variant<3;variant++){ProjectStore s=store();Recovery r=started(s,"A");r.onActivityResult(r.lastRequest,variant==0?0:-1,variant==1?null:new Intent());check(!r.busy&&r.resolver.opens==0&&s.last.exists(),"no write or deletion");}});
 test("recreation orphan blocks B then discards A",()->{ProjectStore s=store();Recovery a=started(s,"A");int old=a.lastRequest;Bundle saved=a.save();a.onDestroy();Recovery b=fresh();b.restoreBackupState(saved);check(b.pendingBackup.backup==null&&b.busy,"routing only");b.prepareBackup(s,"B");check(b.io.q.isEmpty(),"B blocked");b.onActivityResult(old,-1,at(destination()));check(!b.busy&&b.resolver.opens==0,"A discarded");b.prepareBackup(s,"B");b.pump();check(b.lastRequest>old,"fresh code");File d=destination();b.onActivityResult(old,-1,at(d));check(b.busy&&!b.pendingBackup.delivered&&b.resolver.opens==0,"late A cannot consume B");File own=destination();b.onActivityResult(b.lastRequest,-1,at(own));b.pump();check(Files.readString(own.toPath()).equals("B"),"B own destination");});
 test("duplicate while writing cannot release busy",()->{ProjectStore s=store();Recovery r=started(s,"A");File d=destination();int code=r.lastRequest;r.onActivityResult(code,-1,at(d));r.onActivityResult(code,0,null);r.prepareBackup(s,"B");check(r.busy&&r.io.q.size()==1,"one writer, no replacement");r.pump();check(r.resolver.opens==1,"once");});
 test("duplicate after replacement ignored",()->{ProjectStore s=store();Recovery r=started(s,"A");int old=r.lastRequest;r.onActivityResult(old,0,null);r.prepareBackup(s,"B");r.pump();r.onActivityResult(old,-1,at(destination()));check(r.busy&&r.pendingBackup.request==r.lastRequest&&!r.pendingBackup.delivered,"B retained");check(r.resolver.opens==0,"no stale write");});
 test("provider failure settles but retains local backup",()->{ProjectStore s=store();Recovery r=started(s,"A");r.resolver.fail=true;r.onActivityResult(r.lastRequest,-1,at(destination()));r.pump();check(!r.busy&&s.last.exists(),"original backup retained");check(r.notes.stream().anyMatch(n->n.startsWith("Export not fully verified")),"failure truthful");});
 test("checksum mismatch never reports verification",()->{ProjectStore s=store();Recovery r=started(s,"A");r.resolver.corrupt=true;r.onActivityResult(r.lastRequest,-1,at(destination()));r.pump();check(!r.busy&&s.last.exists(),"settled retained");check(r.notes.stream().noneMatch(n->n.startsWith("Export copy readback verified")),"not verified");});
 test("preparation failure can retry with new route",()->{ProjectStore s=store();s.fail=true;Recovery r=fresh();r.prepareBackup(s,"A");int used=r.preparingRequest;r.pump();check(!r.busy,"failure settled");s.fail=false;r.prepareBackup(s,"B");r.pump();check(r.lastRequest>used,"no recycling");});
 test("destroy before queued preparation completion prevents launch",()->{ProjectStore s=store();Recovery r=fresh();r.prepareBackup(s,"A");r.io.drain();r.onDestroy();r.ui.drain();check(r.launches==0&&s.last.exists(),"no dead chooser, backup retained");});
 test("destroy before preparation executes prevents launch",()->{ProjectStore s=store();Recovery r=fresh();r.prepareBackup(s,"A");r.onDestroy();r.pump();check(r.launches==0&&s.last.exists(),"accepted preparation retained without launch");});
 test("preparation saved before launch conservatively orphaned",()->{ProjectStore s=store();Recovery a=fresh();a.prepareBackup(s,"A");Bundle saved=a.save();a.onDestroy();a.pump();Recovery b=fresh();b.restoreBackupState(saved);b.prepareBackup(s,"B");check(b.busy&&b.io.q.isEmpty()&&b.pendingBackup.backup==null,"blocked until orphan settled/task restart");check(a.launches==0,"no old launch");});
 test("late launch after snapshot belongs to restored orphan",()->{ProjectStore s=store();Recovery a=fresh();a.prepareBackup(s,"A");Bundle saved=a.save();a.pump();int old=a.lastRequest;a.onDestroy();Recovery b=fresh();b.restoreBackupState(saved);b.onActivityResult(old,-1,at(destination()));check(!b.busy&&b.resolver.opens==0,"snapshot route discarded");});
 test("active write captured across Activity destruction",()->{ProjectStore s=store();Recovery a=started(s,"A");File d=destination();a.onActivityResult(a.lastRequest,-1,at(d));Bundle saved=a.save();a.onDestroy();Recovery b=fresh();b.restoreBackupState(saved);check(!b.busy,"no orphan for consumed result");a.pump();check(Files.readString(d.toPath()).equals("A")&&a.resolver.opens==1,"accepted write remains exactly captured");});
 test("uncertain launch quarantined then discarded",()->{ProjectStore s=store();Recovery r=fresh();r.launchFail=true;r.prepareBackup(s,"A");r.pump();check(r.busy&&r.pendingBackup.backup==null&&s.last.exists(),"quarantine");r.prepareBackup(s,"B");check(r.io.q.isEmpty(),"no retry");r.onActivityResult(r.lastRequest,-1,at(destination()));check(!r.busy&&r.resolver.opens==0,"late result discarded");});
 test("executor rejects preparation and write safely",()->{ProjectStore s=store();Recovery a=fresh();a.io.reject=true;a.prepareBackup(s,"A");a.ui.drain();check(!a.busy&&s.backups==0,"prepare rejection");Recovery b=started(s,"B");b.io.reject=true;b.onActivityResult(b.lastRequest,-1,at(destination()));check(!b.busy&&b.resolver.opens==0&&s.last.exists(),"write rejection");});
 test("malformed saved state fails closed across another save",()->{for(Object bad:new Object[]{null,1,"04101","-1","65537","NaN"}){Bundle state=new Bundle();state.values.put("recoveryBackupNext",bad);state.putString("recoveryBackupPending","0");Recovery a=fresh();a.restoreBackupState(state);a.prepareBackup(store(),"A");check(a.backupClosed&&a.io.q.isEmpty(),"invalid closed");Recovery b=fresh();b.restoreBackupState(a.save());check(b.backupClosed,"closed survives snapshot");}});
 test("invalid pending routes rejected",()->{for(String p:new String[]{"4101","4102","4099","-1","00","65536"}){Bundle state=new Bundle();state.putString("recoveryBackupNext","4101");state.putString("recoveryBackupPending",p);Recovery a=fresh();a.restoreBackupState(state);check(a.backupClosed,"invalid pending "+p);}});
 test("counter persists with no pending and exhaustion never wraps",()->{ProjectStore s=store();Recovery a=started(s,"A");int old=a.lastRequest;a.onActivityResult(old,0,null);Recovery b=fresh();b.restoreBackupState(a.save());b.prepareBackup(s,"B");b.pump();check(b.lastRequest>old,"counter persisted");b.onActivityResult(b.lastRequest,0,null);b.nextBackupRequest=65535;b.prepareBackup(s,"C");b.pump();check(b.lastRequest==65535,"last low16 route");b.onActivityResult(65535,0,null);Recovery c=fresh();c.restoreBackupState(b.save());c.prepareBackup(s,"D");check(c.nextBackupRequest==65536&&c.io.q.isEmpty()&&!c.backupClosed,"exhaustion no wrap");});
 test("unmatched route cannot cancel orphan",()->{Recovery a=started(store(),"A");Recovery b=fresh();b.restoreBackupState(a.save());b.onActivityResult(9,0,null);check(b.busy&&b.pendingBackup!=null,"unrelated result ignored");});
 test("settlement identity cannot clear replacement",()->{ProjectStore s=store();Recovery a=started(s,"A");Recovery.BackupAttempt old=a.pendingBackup;a.onActivityResult(a.lastRequest,0,null);a.prepareBackup(s,"B");a.pump();a.settleBackup(old);check(a.busy&&a.pendingBackup!=old,"old settlement ignored");});
 System.out.println("PASS "+cases+" scenarios / "+assertions+" assertions; exact production methods, host doubles only");
 }
}
