 static void coordinatorTests()throws Exception {
  scenario("all 9 operation-kind overlaps preserve original owner",()->{
   for(MainActivityOperations.Kind first:MainActivityOperations.Kind.values())for(MainActivityOperations.Kind second:MainActivityOperations.Kind.values()){
    ActivityResultRegistry registry=new ActivityResultRegistry();MainActivityOperations operations=new MainActivityOperations(registry);Owner original=new Owner(),later=new Owner();
    operations.launch(first,new Intent(),original);String key=operations.savedKey();
    expect(IllegalStateException.class,()->operations.launch(second,new Intent(),later),"overlap refused "+first+"/"+second);
    check(operations.savedKey().equals(key)&&registry.launches.size()==1,"original slot/key unchanged");
    check(later.completed+later.invalidated+later.settled==0,"refusal takes no ownership of later owner");
    registry.result(key,picked("original"));check(original.completed==1&&original.settled==1&&original.invalidated==0,"only original complete and settle");
    check(operations.savedKey()==null,"slot clear after definitive result");
   }
  });
  scenario("each kind navigation revokes authority without freeing system slot",()->{
   for(MainActivityOperations.Kind kind:MainActivityOperations.Kind.values()){
    ActivityResultRegistry r=new ActivityResultRegistry();MainActivityOperations o=new MainActivityOperations(r);Owner a=new Owner();o.launch(kind,new Intent(),a);String key=o.savedKey();o.invalidate();o.invalidate();
    check(a.invalidated==1&&a.settled==0&&a.completed==0,"invalidate exactly once, no settle");check(key.equals(o.savedKey()),"in-flight key survives navigation");
    expect(IllegalStateException.class,()->o.launch(kind,new Intent(),new Owner()),"navigation cannot unlock");
    r.result(key,cancelled());check(a.completed==0&&a.settled==1&&a.invalidated==1,"discard revoked return, settle once");check(o.savedKey()==null,"definitive back/cancel unlocks");
   }
  });
  scenario("each kind duplicate result cannot complete or clear replacement",()->{
   for(MainActivityOperations.Kind kind:MainActivityOperations.Kind.values()){
    ActivityResultRegistry r=new ActivityResultRegistry();MainActivityOperations o=new MainActivityOperations(r);Owner a=new Owner(),b=new Owner();o.launch(kind,new Intent(),a);String old=o.savedKey();r.result(old,cancelled());o.launch(kind,new Intent(),b);String next=o.savedKey();
    check(!old.equals(next),"fresh opaque per-attempt registry key");r.duplicate(old,picked("duplicate"));check(next.equals(o.savedKey())&&b.completed==0&&b.settled==0,"replacement unaffected by duplicate");check(a.completed==1&&a.settled==1,"original consumed once");r.result(next,cancelled());
   }
  });
  scenario("all kind synchronous registration dispatch is consumed before launch",()->{
   for(MainActivityOperations.Kind kind:MainActivityOperations.Kind.values()){
    ActivityResultRegistry r=new ActivityResultRegistry();r.synchronousRegistrationResult=cancelled();MainActivityOperations o=new MainActivityOperations(r);Owner a=new Owner();o.launch(kind,new Intent(),a);
    check(a.completed==1&&a.settled==1&&a.invalidated==0,"synchronous callback owns initialized original");check(o.savedKey()==null&&r.launches.isEmpty(),"no launch after synchronous consumption");check(r.active.isEmpty()&&r.unregistrations.size()>=1,"returned launcher unregistered after sync dispatch");
   }
  });
  scenario("each kind launch/register failure quarantines original attempt",()->{
   for(MainActivityOperations.Kind kind:MainActivityOperations.Kind.values())for(ActivityResultRegistry.Failure failure:ActivityResultRegistry.Failure.values()){
    if(failure==ActivityResultRegistry.Failure.NONE)continue;
    ActivityResultRegistry r=new ActivityResultRegistry();r.failure=failure;MainActivityOperations o=new MainActivityOperations(r);Owner a=new Owner();
    expect(MainActivityOperations.LaunchFailure.class,()->o.launch(kind,new Intent(),a),"uncertain provider failure "+failure);String key=o.savedKey();
    check(key!=null&&a.invalidated==1&&a.completed==0&&a.settled==0,"failure retains slot without resource settlement");
    expect(IllegalStateException.class,()->o.launch(kind,new Intent(),new Owner()),"uncertain launch cannot retry");
    check(r.launches.size()==(failure==ActivityResultRegistry.Failure.LAUNCH_AFTER?1:0),"no automatic retry "+failure);
    if(r.history.containsKey(key)){r.failure=ActivityResultRegistry.Failure.NONE;r.result(key,cancelled());check(o.savedKey()==null&&a.settled==1&&a.completed==0,"late definitive result settles quarantined original");}
    else {o.close();check(a.settled==0,"closed register failure is not a result");ActivityResultRegistry replacement=new ActivityResultRegistry();MainActivityOperations restored=new MainActivityOperations(replacement);restored.restore(key);replacement.result(key,cancelled());check(restored.savedKey()==null,"restored discard-only key eventually clears");}
   }
  });
  scenario("restore stores opaque key only and discards orphan result",()->{
   ActivityResultRegistry r=new ActivityResultRegistry();MainActivityOperations o=new MainActivityOperations(r);Owner original=new Owner();o.launch(MainActivityOperations.Kind.FILE_PICKER,new Intent(),original);String key=o.savedKey();o.close();o.close();check(original.invalidated==1&&original.settled==0,"close revokes without settling");check(r.active.isEmpty(),"closed registry detached");
   expect(IllegalStateException.class,()->o.launch(MainActivityOperations.Kind.FILE_PICKER,new Intent(),new Owner()),"closed owner cannot reopen");
   ActivityResultRegistry rr=new ActivityResultRegistry();MainActivityOperations replacement=new MainActivityOperations(rr);replacement.restore(key);check(rr.launches.isEmpty()&&key.equals(replacement.savedKey()),"restore registers but never relaunches");
   expect(IllegalStateException.class,()->replacement.launch(MainActivityOperations.Kind.DIAGNOSTIC_SAVE,new Intent(),new Owner()),"orphan blocks all operation kinds");rr.result(key,picked("orphan"));check(replacement.savedKey()==null&&original.completed==0&&original.settled==0,"orphan grants no original/cross-activity authority");
   Owner next=new Owner();replacement.launch(MainActivityOperations.Kind.NATIVE_GAUSSIAN,new Intent(),next);String nextKey=replacement.savedKey();rr.duplicate(key,picked("duplicate orphan"));check(nextKey.equals(replacement.savedKey())&&next.completed==0,"orphan duplicate cannot affect replacement");
  });
  scenario("restored pending result can dispatch synchronously during registration",()->{
   String key="bwv-operation-11111111-1111-1111-1111-111111111111";ActivityResultRegistry r=new ActivityResultRegistry();r.queued.put(key,picked("queued orphan"));MainActivityOperations o=new MainActivityOperations(r);o.restore(key);check(o.savedKey()==null&&r.active.isEmpty()&&r.launches.isEmpty(),"sync restored result discarded and no relaunch");
  });
  scenario("invalid restored authority and null launch arguments are refused before ownership",()->{
   ActivityResultRegistry r=new ActivityResultRegistry();MainActivityOperations o=new MainActivityOperations(r);for(String key:List.of("project="+PROJECT_A,"bwv-operation-../project","bwv-operation-11111111-1111-1111-1111-111111111111:DIAGNOSTIC_SAVE",""))expect(IllegalStateException.class,()->o.restore(key),"invalid restoration");o.restore(null);Owner a=new Owner();
   expect(NullPointerException.class,()->o.launch(null,new Intent(),a),"null kind");expect(NullPointerException.class,()->o.launch(MainActivityOperations.Kind.FILE_PICKER,null,a),"null intent");expect(NullPointerException.class,()->o.launch(MainActivityOperations.Kind.FILE_PICKER,new Intent(),null),"null owner");check(o.savedKey()==null&&r.registrations.isEmpty()&&a.invalidated+a.settled==0,"invalid calls transfer no ownership");
  });
  scenario("coordinator operations require UI thread",()->{
   ActivityResultRegistry r=new ActivityResultRegistry();MainActivityOperations o=new MainActivityOperations(r);Owner a=new Owner();o.launch(MainActivityOperations.Kind.FILE_PICKER,new Intent(),a);String key=o.savedKey();
   worker(()->{expect(IllegalStateException.class,()->o.launch(MainActivityOperations.Kind.FILE_PICKER,new Intent(),new Owner()),"launch off UI");expect(IllegalStateException.class,o::invalidate,"invalidate off UI");expect(IllegalStateException.class,o::savedKey,"save off UI");expect(IllegalStateException.class,()->o.restore(null),"restore off UI");expect(IllegalStateException.class,o::close,"close off UI");expect(IllegalStateException.class,()->r.result(key,cancelled()),"callback off UI");});
   check(key.equals(o.savedKey())&&a.completed+a.invalidated+a.settled==0,"wrong thread never changes authority");r.result(key,cancelled());
  });
  scenario("reentrant completion cannot clear a newly acquired slot",()->{
   ActivityResultRegistry r=new ActivityResultRegistry();MainActivityOperations o=new MainActivityOperations(r);Owner a=new Owner(),b=new Owner();a.onComplete=()->o.launch(MainActivityOperations.Kind.NATIVE_GAUSSIAN,new Intent(),b);o.launch(MainActivityOperations.Kind.FILE_PICKER,new Intent(),a);String key=o.savedKey();r.result(key,cancelled());String later=o.savedKey();check(later!=null&&!later.equals(key)&&a.settled==1,"reentrant new slot survives original settle");r.duplicate(key,cancelled());check(later.equals(o.savedKey())&&b.completed==0,"duplicate original does not clear reentrant successor");
  });
  scenario("owner exception still settles once and cannot be replayed",()->{
   ActivityResultRegistry r=new ActivityResultRegistry();MainActivityOperations o=new MainActivityOperations(r);Owner a=new Owner();a.throwComplete=true;o.launch(MainActivityOperations.Kind.DIAGNOSTIC_SAVE,new Intent(),a);String key=o.savedKey();r.rawResult(key,saved(true));check(a.completed==1&&a.invalidated==1&&a.settled==1&&o.savedKey()==null,"exception consumes and settles original");r.duplicate(key,saved(true));check(a.completed==1&&a.settled==1,"failed callback not replayed");
  });
 }

 static void registryOrderTests()throws Exception {
  scenario("AndroidX raw-result callback order retains mapping until deferred cleanup",()->{
   ActivityResultRegistry r=new ActivityResultRegistry();MainActivityOperations o=new MainActivityOperations(r);
   for(int round=0;round<18;round++)for(MainActivityOperations.Kind kind:MainActivityOperations.Kind.values()){
    Owner original=new Owner();o.launch(kind,new Intent(),original);String old=o.savedKey();check(r.launchedKeys.contains(old),"actual launch marker set");r.rawResult(old,cancelled());
    check(original.completed==1&&original.settled==1&&!r.launchedKeys.contains(old)&&!r.active.containsKey(old),"raw result callback returns before launch marker removal");check(r.keyToRc.containsKey(old)&&r.rcToKey.size()==1,"first unregister during callback preserves in-flight request code");
    Owner replacement=new Owner();o.launch(kind,new Intent(),replacement);String next=o.savedKey();android.os.Handler.drain();check(r.keyToRc.size()==1&&r.keyToRc.containsKey(next)&&r.rcToKey.size()==1,"captured old launcher cleanup never unregisters new key");check(r.active.containsKey(next)&&r.launchedKeys.contains(next)&&replacement.completed==0,"replacement still live after old deferred cleanup");
    r.rawResult(next,cancelled());android.os.Handler.drain();check(r.keyToRc.isEmpty()&&r.rcToKey.isEmpty()&&r.active.isEmpty()&&r.launchedKeys.isEmpty(),"repeated completed operations reclaim both request-code maps");
   }
  });
  scenario("owner complete invalidated and settled failures cannot interrupt raw trailing bookkeeping",()->{
   for(int variant=0;variant<4;variant++){
    ActivityResultRegistry r=new ActivityResultRegistry();MainActivityOperations o=new MainActivityOperations(r);Owner a=new Owner();a.throwComplete=variant==0||variant==3;a.throwInvalidated=variant==1||variant==3;a.throwSettled=variant==2||variant==3;o.launch(MainActivityOperations.Kind.DIAGNOSTIC_SAVE,new Intent(),a);String key=o.savedKey();if(variant==1)o.invalidate();r.rawResult(key,saved(true));check(!r.launchedKeys.contains(key)&&o.savedKey()==null,"raw source trailing cleanup runs despite owner callback failures");check(a.settled==1&&a.invalidated==1,"each failure has one settlement and one invalidation");android.os.Handler.drain();check(r.keyToRc.isEmpty()&&r.rcToKey.isEmpty(),"callback failures do not leak completed request mappings");
   }
  });
  scenario("definitive synchronous launch result wins over later provider throw and reentrant replacement",()->{
   Bridge b=new Bridge();Owner original=new Owner(),replacement=new Owner();b.activity.registry.failure=ActivityResultRegistry.Failure.LAUNCH_AFTER;b.activity.registry.synchronousLaunchResult=cancelled();
   original.onComplete=()->{b.activity.registry.failure=ActivityResultRegistry.Failure.NONE;b.activity.launchOperation(MainActivityOperations.Kind.NATIVE_GAUSSIAN,new Intent(),replacement);};
   b.activity.launchOperation(MainActivityOperations.Kind.FILE_PICKER,new Intent(),original);String key=b.activity.operations.savedKey();check(original.completed==1&&original.settled==1&&original.invalidated==0,"definitive completion not retroactively revoked");check(!b.activity.recovering&&b.activity.diagnostics.events.isEmpty(),"old post-result exception cannot enter recovery");check(key!=null&&b.activity.registry.launches.size()==2&&replacement.invalidated+replacement.completed==0,"reentrant replacement remains owner");android.os.Handler.drain();check(b.activity.registry.keyToRc.size()==1&&b.activity.registry.active.containsKey(key),"old deferred retirement keeps replacement registration");b.activity.registry.rawResult(key,gaussian(true));check(replacement.completed==1,"replacement receives its own definitive result");
  });
  scenario("synchronous registration result then throw cannot revoke replacement",()->{
   ActivityResultRegistry r=new ActivityResultRegistry();MainActivityOperations o=new MainActivityOperations(r);Owner original=new Owner(),replacement=new Owner();r.failure=ActivityResultRegistry.Failure.REGISTER_AFTER;r.synchronousRegistrationResult=cancelled();original.onComplete=()->{r.failure=ActivityResultRegistry.Failure.NONE;o.launch(MainActivityOperations.Kind.DIAGNOSTIC_SAVE,new Intent(),replacement);};o.launch(MainActivityOperations.Kind.FILE_PICKER,new Intent(),original);String key=o.savedKey();check(original.completed==1&&original.settled==1&&original.invalidated==0,"registration's definitive result wins over synthetic trailing throw");check(key!=null&&replacement.invalidated+replacement.completed==0&&r.launches.size()==1,"replacement survives registration result-then-throw");r.rawResult(key,cancelled());check(replacement.completed==1,"replacement retains exact callback");
  });
  scenario("uncertain AndroidX launch removes marker so late raw result queues until orphan restoration",()->{
   ActivityResultRegistry r=new ActivityResultRegistry();MainActivityOperations o=new MainActivityOperations(r);Owner original=new Owner();r.failure=ActivityResultRegistry.Failure.LAUNCH_AFTER;expect(MainActivityOperations.LaunchFailure.class,()->o.launch(MainActivityOperations.Kind.DIAGNOSTIC_SAVE,new Intent(),original),"source-exact uncertain launch");String key=o.savedKey();check(!r.launchedKeys.contains(key),"AndroidX launch catch removes marker even if OS outcome uncertain");r.rawResult(key,saved(true));check(r.queued.containsKey(key)&&original.completed==0&&original.settled==0&&key.equals(o.savedKey()),"late raw result queues, not live-owner settlement");
   ActivityResultRegistry restored=new ActivityResultRegistry();restored.restoreRoutingFrom(r);o.close();MainActivityOperations next=new MainActivityOperations(restored);next.restore(key);check(next.savedKey()==null&&original.completed==0&&original.settled==0,"queued raw result consumed by discard-only orphan, not original call");android.os.Handler.drain();check(restored.keyToRc.isEmpty()&&restored.active.isEmpty(),"orphan synchronous consume reclaims restored mapping");
  });

  scenario("completed raw result saved before Handler drain does not persist completed routing",()->{
   Bridge b=new Bridge();Owner original=new Owner();b.activity.launchOperation(MainActivityOperations.Kind.FILE_PICKER,new Intent(),original);String key=b.activity.operations.savedKey();b.activity.registry.rawResult(key,cancelled());check(b.activity.registry.keyToRc.containsKey(key)&&android.os.Handler.pending()>0,"callback returned with deferred mapping cleanup outstanding");Bundle state=new Bundle();b.activity.saveOperations(state);check(state.values.get("bwv.native.pendingOperationKey")==null&&"0".equals(state.values.get("bwv.native.restoredOperationCount")),"save has no pending operation key after definitive result");check(b.activity.registry.keyToRc.isEmpty()&&b.activity.registry.rcToKey.isEmpty(),"save outside callback flushes completed key before framework snapshot");ActivityResultRegistry restoredRegistry=new ActivityResultRegistry();restoredRegistry.restoreRoutingFrom(b.activity.registry);Bridge restored=new Bridge(restoredRegistry,state);check(restored.activity.operations.savedKey()==null&&restoredRegistry.keyToRc.isEmpty()&&restoredRegistry.active.isEmpty(),"recreate has no completed orphan mapping");
  });
  scenario("save-before-cleanup flushes old completed ticket but never active replacement",()->{
   Bridge b=new Bridge();Owner original=new Owner(),replacement=new Owner();b.activity.launchOperation(MainActivityOperations.Kind.FILE_PICKER,new Intent(),original);String old=b.activity.operations.savedKey();b.activity.registry.rawResult(old,cancelled());b.activity.launchOperation(MainActivityOperations.Kind.NATIVE_GAUSSIAN,new Intent(),replacement);String next=b.activity.registry.latestKey();check(b.activity.registry.keyToRc.size()==2,"old deferred and new active mappings coexist before save");Bundle state=new Bundle();b.activity.saveOperations(state);check(state.values.containsValue(next)&&b.activity.registry.keyToRc.size()==1&&b.activity.registry.active.containsKey(next)&&b.activity.registry.launchedKeys.contains(next),"save flushes only exact old launcher and preserves replacement key/marker");android.os.Handler.drain();check(b.activity.registry.keyToRc.containsKey(next)&&replacement.completed+replacement.invalidated==0,"posted old cleanup remains idempotent after explicit save flush");
   ActivityResultRegistry restoredRegistry=new ActivityResultRegistry();restoredRegistry.restoreRoutingFrom(b.activity.registry);b.activity.closeOperations();Bridge restored=new Bridge(restoredRegistry,state);restoredRegistry.rawResult(next,gaussian(true));check(restored.activity.operations.savedKey()==null&&replacement.completed==0&&replacement.invalidated==1,"restored replacement key is discard-only despite original native owner");
  });
  scenario("stored-pending orphan retains AndroidX marker mapping but no call authority",()->{
   ActivityResultRegistry r=new ActivityResultRegistry();MainActivityOperations o=new MainActivityOperations(r);Owner original=new Owner();o.launch(MainActivityOperations.Kind.FILE_PICKER,new Intent(),original);String key=o.savedKey();o.close();r.rawResult(key,picked("arrived while unregistered"));check(r.queued.containsKey(key)&&r.launchedKeys.contains(key),"raw result with absent callback preserves framework launch marker");ActivityResultRegistry rr=new ActivityResultRegistry();rr.restoreRoutingFrom(r);MainActivityOperations restored=new MainActivityOperations(rr);restored.restore(key);android.os.Handler.drain();check(restored.savedKey()==null&&rr.active.isEmpty()&&original.completed==0&&original.settled==0,"synchronous restored result discards all owner authority");check(rr.launchedKeys.contains(key)&&rr.keyToRc.containsKey(key)&&rr.rcToKey.size()==1,"documented framework marker/request mapping residue remains after second unregister");Owner next=new Owner();restored.launch(MainActivityOperations.Kind.NATIVE_GAUSSIAN,new Intent(),next);String current=restored.savedKey();rr.rawResult(current,gaussian(true));android.os.Handler.drain();check(next.completed==1&&rr.active.isEmpty()&&rr.keyToRc.size()==1&&rr.keyToRc.containsKey(key),"fresh operation completes normally; old orphan has no callback despite residual mapping");
  });
  scenario("in-flight AndroidX raw result after recreation retires restored key without authority",()->{
   ActivityResultRegistry r=new ActivityResultRegistry();MainActivityOperations o=new MainActivityOperations(r);Owner original=new Owner();o.launch(MainActivityOperations.Kind.FILE_PICKER,new Intent(),original);String key=o.savedKey();ActivityResultRegistry restored=new ActivityResultRegistry();restored.restoreRoutingFrom(r);o.close();MainActivityOperations next=new MainActivityOperations(restored);next.restore(key);check(restored.launchedKeys.contains(key),"framework routing state preserves outstanding raw launch marker");restored.rawResult(key,picked("orphan"));check(next.savedKey()==null&&original.completed==0&&original.settled==0,"restored raw return consumes orphan without JS/project authority");android.os.Handler.drain();check(restored.keyToRc.isEmpty()&&restored.rcToKey.isEmpty(),"restored orphan raw result mappings reclaimed");
  });
 }
 static void pluginTests()throws Exception {
  scenario("actual picker prevents stale A selection being assigned to B",()->{
   Bridge b=new Bridge();PluginCall original=b.call("reused","pickFiles");b.projects.pickFiles(original);String key=b.activity.registry.latestKey();b.reload();PluginCall later=b.call("reused","pickFiles");later.data.put("id",PROJECT_B);b.projects.pickFiles(later);check(later.rejected==1&&b.activity.registry.launches.size()==1,"B blocked while A outstanding even with reused callback ID");check(original.released==1,"A native call invalidated once");b.activity.registry.result(key,picked("from-A"));worker(b.projects.IO::drain);check(b.projects.store.imports.isEmpty()&&later.resolved==0&&original.resolved==0,"stale A never imports/resolves as B");
   PluginCall replacement=b.call("reused","pickFiles");replacement.data.put("id",PROJECT_B);b.projects.pickFiles(replacement);String next=b.activity.registry.latestKey();b.activity.registry.duplicate(key,picked("late-A"));check(next.equals(b.activity.operations.savedKey()),"duplicate A leaves B in flight");b.activity.registry.result(next,picked("from-B"));worker(b.projects.IO::drain);check(b.projects.store.imports.equals(List.of(PROJECT_B+":[content://from-B]"))&&replacement.resolved==1,"only B selection imports B project");
  });
  scenario("actual Gaussian return cannot resolve later picker call",()->{
   Bridge b=new Bridge();PluginCall original=b.call("same","openNativeGaussian");startGaussian(b,original);String key=b.activity.registry.latestKey();PluginCall later=b.call("same","pickFiles");b.projects.pickFiles(later);check(later.rejected==1&&later.resolved==0,"picker overlap rejected");b.activity.registry.result(key,gaussian(true));check(original.resolved==1&&Boolean.TRUE.equals(original.result.values.get("compatibility")),"Gaussian result belongs to Gaussian original");check(later.resolved==0&&b.projects.store.imports.isEmpty(),"no cross-operation picker authority");
  });
  scenario("picker original project ID is captured before queued UI and result",()->{
   Bridge b=new Bridge();PluginCall original=b.call("p","pickFiles");worker(()->b.projects.pickFiles(original));check(b.ui.size()==1&&b.activity.registry.launches.isEmpty(),"UI launch deliberately queued");original.data.put("id",PROJECT_B);b.drainUi();String key=b.activity.registry.latestKey();b.activity.registry.result(key,picked("capture"));original.data.put("id","33333333-3333-3333-3333-333333333333");worker(b.projects.IO::drain);check(b.projects.store.imports.equals(List.of(PROJECT_A+":[content://capture]")),"import uses launch-time original project, not mutable call data");
  });
  scenario("Gaussian captures project keys and language before queued IO",()->{
   Bridge b=new Bridge();PluginCall original=b.call("g","openNativeGaussian");JSONArray keys=new JSONArray().put("old-key");original.data.put("keys",keys).put("lang","en");b.projects.openNativeGaussian(original);keys.put("injected");original.data.put("id",PROJECT_B).put("keys",new JSONArray().put("wrong-key")).put("lang","fr");worker(b.projects.IO::drain);b.drainUi();String key=b.activity.registry.latestKey();Intent launched=(Intent)b.activity.registry.inputs.get(key);check(PROJECT_A.equals(launched.getStringExtra("project")),"captured Gaussian project");check("[\"old-key\"]".equals(launched.getStringExtra("keys"))&&"en".equals(launched.getStringExtra("lang")),"keys serialized and language captured before IO");check(b.projects.store.gets.equals(List.of(PROJECT_A)),"native authorization used original project");
  });
  scenario("navigation before queued picker UI or Gaussian IO prevents launch",()->{
   Bridge picker=new Bridge();PluginCall p=picker.call("p","pickFiles");worker(()->picker.projects.pickFiles(p));picker.reload();picker.drainUi();check(picker.activity.registry.launches.isEmpty(),"stale queued picker never launches");
   Bridge gaussian=new Bridge();PluginCall g=gaussian.call("g","openNativeGaussian");gaussian.projects.openNativeGaussian(g);gaussian.reload();worker(gaussian.projects.IO::drain);gaussian.drainUi();check(gaussian.activity.registry.launches.isEmpty()&&gaussian.projects.store.gets.isEmpty(),"stale queued Gaussian never accesses project or launches");
   Bridge between=new Bridge();PluginCall h=between.call("h","openNativeGaussian");between.projects.openNativeGaussian(h);worker(between.projects.IO::drain);between.reload();between.drainUi();check(between.activity.registry.launches.isEmpty(),"navigation between Gaussian IO authorization and UI launch rechecked");
  });
  scenario("queued picker import rechecks original provenance before I/O",()->{
   Bridge b=new Bridge();PluginCall original=b.call("p","pickFiles");b.projects.pickFiles(original);b.activity.registry.result(b.activity.registry.latestKey(),picked("before-navigation"));check(b.projects.IO.size()==1,"picker import queued");b.reload();PluginCall replacement=b.call("p","pickFiles");replacement.data.put("id",PROJECT_B);worker(b.projects.IO::drain);check(b.projects.store.imports.isEmpty()&&original.resolved==0&&replacement.resolved==0,"old queued IO cannot execute under replacement authority");
  });
  scenario("actual run checks provenance again before delivering queued result",()->{
   Bridge b=new Bridge();PluginCall original=b.call("p","pickFiles");b.projects.pickFiles(original);b.activity.registry.result(b.activity.registry.latestKey(),picked("commit"));b.projects.store.duringImport=()->BwvBridgeCallGuard.documentStarted(b.webView,b.webView.url);worker(b.projects.IO::drain);check(b.projects.store.imports.size()==1&&original.resolved==0,"document expiry after IO does not deliver result into new document");
  });
  scenario("picker back cancel null return and content URI selection",()->{
   for(ActivityResult result:Arrays.asList(cancelled(),null,new ActivityResult(Activity.RESULT_OK,null))){Bridge b=new Bridge();PluginCall p=b.call("cancel","pickFiles");b.projects.pickFiles(p);b.activity.registry.result(b.activity.registry.latestKey(),result);check(p.resolved==1&&Boolean.TRUE.equals(p.result.values.get("cancelled"))&&b.projects.IO.size()==0,"cancel/null has no import side effect");}
   Bridge b=new Bridge();PluginCall p=b.call("uri","pickFiles");b.projects.pickFiles(p);Intent data=new Intent().setData(Uri.parse("file:///private")).setClipData(new ClipData(Uri.parse("content://one"),Uri.parse("content://one"),Uri.parse("content://two")));b.activity.registry.result(b.activity.registry.latestKey(),new ActivityResult(Activity.RESULT_OK,data));worker(b.projects.IO::drain);check(b.projects.store.imports.equals(List.of(PROJECT_A+":[content://one, content://two]")),"actual URI method filters non-content and deduplicates selections");
  });
  scenario("Gaussian back cancel null result completes exact original only",()->{
   for(ActivityResult result:Arrays.asList(cancelled(),null,gaussian(false))){Bridge b=new Bridge();PluginCall g=b.call("g","openNativeGaussian");startGaussian(b,g);b.activity.registry.result(b.activity.registry.latestKey(),result);check(g.resolved==1&&Boolean.FALSE.equals(g.result.values.get("compatibility")),"cancel reports false compatibility for original");}
   Bridge b=new Bridge();PluginCall g=b.call("g","openNativeGaussian");startGaussian(b,g);String key=b.activity.registry.latestKey();b.reload();b.activity.registry.result(key,gaussian(true));check(g.resolved==0&&g.released==1,"navigation discards Gaussian result");
  });
  scenario("actual MainActivity save/restore helper retains only orphan key",()->{
   Bridge b=new Bridge();PluginCall p=b.call("id","pickFiles");b.projects.pickFiles(p);Bundle state=new Bundle();b.activity.saveOperations(state);check(state.values.size()==2&&((String)state.values.get("bwv.native.pendingOperationKey")).startsWith("bwv-operation-")&&"0".equals(state.values.get("bwv.native.restoredOperationCount")),"bundle stores only opaque key and decimal restore count, no call/project/arguments");String key=b.activity.operations.savedKey();b.activity.closeOperations();Bridge restored=new Bridge(new ActivityResultRegistry(),state);check(key.equals(restored.activity.operations.savedKey()),"actual initialize helper restores pending key");PluginCall newCall=restored.call("id","pickFiles");restored.projects.pickFiles(newCall);check(newCall.rejected==1,"new document cannot replace restored orphan");restored.activity.registry.result(key,picked("orphan"));worker(restored.projects.IO::drain);check(restored.projects.store.imports.isEmpty()&&p.resolved==0&&newCall.resolved==0,"orphan result never imports or resolves");
  });
  scenario("synchronous registration is safe in all three actual plugin paths",()->{
   Bridge p=new Bridge();PluginCall picker=p.call("p","pickFiles");p.activity.registry.synchronousRegistrationResult=cancelled();p.projects.pickFiles(picker);check(picker.resolved==1&&p.activity.registry.launches.isEmpty(),"picker synchronous original cancellation");
   Bridge g=new Bridge();PluginCall gaussian=g.call("g","openNativeGaussian");g.activity.registry.synchronousRegistrationResult=gaussian(true);startGaussian(g,gaussian);check(gaussian.resolved==1&&g.activity.registry.launches.isEmpty(),"Gaussian synchronous original completion");
   Bridge r=new Bridge();r.diagnosticPage();PluginCall report=r.call("r","exportReport");r.activity.registry.synchronousRegistrationResult=saved(true);r.reports.exportReport(report);check(report.resolved==1&&r.activity.registry.launches.isEmpty(),"report synchronous original completion");assertLease(r,false,"report sync definitive result settles lease");
  });
  scenario("diagnostic save success cancel null and explicit failure settle exact lease",()->{
   for(ActivityResult result:Arrays.asList(saved(true),cancelled(),null,new ActivityResult(Activity.RESULT_CANCELED,new Intent().putExtra("failed",true)))){
    Bridge b=new Bridge();b.diagnosticPage();PluginCall report=b.call("report","exportReport");b.reports.exportReport(report);assertLease(b,true,"report reserved through external save");b.activity.registry.result(b.activity.registry.latestKey(),result);assertLease(b,false,"definitive report return releases lease");
    boolean failed=result!=null&&result.getData()!=null&&result.getData().getBooleanExtra("failed",false);check(failed?report.rejected==1&&report.resolved==0:report.resolved==1&&report.rejected==0,"exact report outcome delivered");if(!failed){boolean success=result!=null&&result.getResultCode()==Activity.RESULT_OK;check(Boolean.valueOf(success).equals(report.result.values.get("readbackVerified"))&&Boolean.valueOf(!success).equals(report.result.values.get("cancelled")),"report flags reflect definitive outcome");}
   }
  });
  scenario("report invalidation preserves lease until definitive result",()->{
   Bridge b=new Bridge();b.diagnosticPage();PluginCall original=b.call("r","exportReport");b.reports.exportReport(original);String key=b.activity.registry.latestKey();b.reload();check(original.released==1,"original report authority released on navigation");assertLease(b,true,"navigation is not a definitive export release");PluginCall later=b.call("r","exportReport");b.reports.exportReport(later);check(later.rejected==1&&b.activity.registry.launches.size()==1,"replacement report blocked by original lease/slot");b.activity.registry.result(key,saved(true));assertLease(b,false,"revoked original definitive result settles lease");check(original.resolved==0&&later.resolved==0,"stale report not delivered as later call");
   PluginCall replacement=b.call("r","exportReport");b.reports.exportReport(replacement);String next=b.activity.registry.latestKey();String token=b.reports.service.lastExport.token();b.activity.registry.duplicate(key,saved(true));check(next.equals(b.activity.operations.savedKey())&&b.reports.service.exports.get(token)!=null&&replacement.resolved==0,"old result cannot finish replacement lease or call");
  });
  scenario("report overlap rejected before ownership cleans newly reserved lease",()->{
   Bridge b=new Bridge();b.diagnosticPage();Owner original=new Owner();b.activity.launchOperation(MainActivityOperations.Kind.FILE_PICKER,new Intent(),original);String key=b.activity.operations.savedKey();PluginCall report=b.call("r","exportReport");b.reports.exportReport(report);check(report.rejected==1&&b.reports.service.reserveCount==1,"report reserved then busy rejection");assertLease(b,false,"pre-ownership refusal cleans report reservation");check(key.equals(b.activity.operations.savedKey())&&original.completed+original.invalidated+original.settled==0,"original other-kind operation untouched");
  });
  scenario("all actual launch paths fail closed on uncertain provider failure",()->{
   for(String method:List.of("pickFiles","openNativeGaussian","exportReport"))for(ActivityResultRegistry.Failure failure:List.of(ActivityResultRegistry.Failure.REGISTER_BEFORE,ActivityResultRegistry.Failure.REGISTER_AFTER,ActivityResultRegistry.Failure.LAUNCH_BEFORE,ActivityResultRegistry.Failure.LAUNCH_AFTER)){
    Bridge b=new Bridge();if(method.equals("exportReport"))b.diagnosticPage();PluginCall call=b.call("call",method);b.activity.registry.failure=failure;
    switch(method){case "pickFiles"->b.projects.pickFiles(call);case "openNativeGaussian"->startGaussian(b,call);case "exportReport"->b.reports.exportReport(call);default->throw new AssertionError();}
    String key=b.activity.operations.savedKey();check(b.activity.recovering&&b.activity.finishing&&key!=null,"actual helper enters recovery retaining original slot "+method+"/"+failure);check(call.released==1&&call.resolved==0&&call.rejected==1,"uncertain original invalidated once and not resolved");check(b.activity.diagnostics.events.size()==1,"one diagnostic, no retry");check(!BwvBridgeCallGuard.current(call,b.webView),"recovery destroys document authority");
    if(method.equals("exportReport")){assertLease(b,true,"uncertain report launch must retain lease");if(b.activity.registry.history.containsKey(key)){b.activity.registry.failure=ActivityResultRegistry.Failure.NONE;b.activity.registry.result(key,cancelled());assertLease(b,false,"late definitive result settles uncertain report lease");}else{b.activity.closeOperations();assertLease(b,true,"close cannot invent a definitive result");}}
   }
  });
  scenario("report active writer remains quarantined after definitive UI completion",()->{
   Bridge b=new Bridge();b.diagnosticPage();PluginCall report=b.call("r","exportReport");b.reports.exportReport(report);String key=b.activity.registry.latestKey();DiagnosticExportLease.Export export=b.reports.service.lastExport;DiagnosticExportLease.Export writing=b.reports.service.exports.beginWrite(export.token());b.activity.registry.result(key,cancelled());assertLease(b,true,"definitive UI callback cannot release active writer");expect(IOException.class,()->b.reports.service.exports.reserve(RUN,new byte[]{1}),"writer blocks replacement reservation");b.reports.service.exports.complete(writing,true);assertLease(b,false,"exact writer completion releases abandoned lease");
   DiagnosticExportLease.Export replacement=b.reports.service.exports.reserve(RUN,new byte[]{2});expect(IOException.class,()->b.reports.service.exports.complete(writing,true),"stale write completion cannot alter replacement");check(b.reports.service.exports.get(replacement.token())==replacement,"replacement lease exact identity preserved");
  });
  scenario("native report Activity destruction releases only on finishing",()->{
   NativeDiagnosticService service=new NativeDiagnosticService();DiagnosticExportLease.Export export=service.reserveExport(RUN,"{} ");DiagnosticReportSaveActivity activity=new DiagnosticReportSaveActivity();activity.service=service;activity.token=export.token();activity.onDestroy();check(service.exports.busy(),"rotation/non-finishing does not release export");activity.finishing=true;activity.onDestroy();check(!service.exports.busy(),"definitive native finishing releases export independently of orphan JS owner");
  });
  scenario("report reply provider exception still settles original reservation",()->{
   Bridge b=new Bridge();b.diagnosticPage();PluginCall report=b.call("r","exportReport");b.reports.exportReport(report);report.failResolve=true;String key=b.activity.registry.latestKey();b.activity.registry.rawResult(key,saved(true));assertLease(b,false,"settled finally releases lease despite failed report delivery");check(b.activity.operations.savedKey()==null&&report.released==1,"failed report reply cannot retain reusable callback authority");
  });
 }
 static Bundle operationState(String key,String count){Bundle state=new Bundle();state.putString("bwv.native.pendingOperationKey",key);state.putString("bwv.native.restoredOperationCount",count);return state;}
 static void restoreBudgetTests()throws Exception {
  scenario("restoration constructor bounds null restore and normal-operation liveness",()->{
   check(MainActivityOperations.MAX_RESTORED_ATTEMPTS==16,"explicit conservative restoration budget is sixteen");
   for(int count:new int[]{-1,17,Integer.MIN_VALUE,Integer.MAX_VALUE})expect(IllegalStateException.class,()->new MainActivityOperations(new ActivityResultRegistry(),count),"invalid native restoration counter");
   ActivityResultRegistry r=new ActivityResultRegistry();MainActivityOperations operations=new MainActivityOperations(r,16);operations.restore(null);check(operations.restoredCount()==16,"null restore consumes no budget at cap");
   for(int round=0;round<24;round++){Owner owner=new Owner();operations.launch(MainActivityOperations.Kind.values()[round%3],new Intent(),owner);String key=operations.savedKey();r.rawResult(key,cancelled());android.os.Handler.drain();check(owner.completed==1&&owner.settled==1&&operations.restoredCount()==16,"normal completed operation does not consume restoration budget");}
   check(r.keyToRc.isEmpty()&&r.launchedKeys.isEmpty(),"normal operations remain live at cap with completed mappings reclaimed");worker(()->expect(IllegalStateException.class,operations::restoredCount,"restore count read off UI"));
   MainActivityOperations fresh=new MainActivityOperations(new ActivityResultRegistry());check(fresh.restoredCount()==0,"fresh constructor starts zero");
  });
  scenario("sixteen source-order stored-pending orphan records then seventeenth fails before register",()->{
   ActivityResultRegistry registry=new ActivityResultRegistry();registry.register("unrelated-capacitor",new androidx.activity.result.contract.ActivityResultContracts.StartActivityForResult(),result->{}).launch(new Intent());MainActivityOperations current=new MainActivityOperations(registry);List<Owner> originals=new ArrayList<>();
   for(int step=1;step<=16;step++){
    Owner owner=new Owner();originals.add(owner);current.launch(MainActivityOperations.Kind.FILE_PICKER,new Intent(),owner);String key=current.savedKey();int count=current.restoredCount();current.close();registry.rawResult(key,picked("orphan-"+step));ActivityResultRegistry replacement=new ActivityResultRegistry();replacement.restoreRoutingFrom(registry);current=new MainActivityOperations(replacement,count);current.restore(key);android.os.Handler.drain();registry=replacement;
    check(current.restoredCount()==step,"one restoration consumed per orphan lineage step");check(current.savedKey()==null&&registry.active.isEmpty()&&owner.completed==0&&owner.settled==0&&owner.invalidated==1,"stored pending orphan discards original authority");check(registry.keyToRc.size()==step+1&&registry.rcToKey.size()==step+1&&registry.launchedKeys.size()==step+1&&registry.keyToRc.containsKey("unrelated-capacitor")&&registry.keyToRc.keySet().stream().filter(k->k.startsWith("bwv-operation-")).count()==step,"app-owned residue grows by one admitted orphan without altering unrelated Capacitor mapping");
   }
   Owner finalOwner=new Owner();originals.add(finalOwner);current.launch(MainActivityOperations.Kind.NATIVE_GAUSSIAN,new Intent(),finalOwner);String finalKey=current.savedKey();current.close();registry.rawResult(finalKey,gaussian(true));ActivityResultRegistry blockedRegistry=new ActivityResultRegistry();blockedRegistry.restoreRoutingFrom(registry);MainActivityOperations blocked=new MainActivityOperations(blockedRegistry,16);
   expect(IllegalStateException.class,()->blocked.restore(finalKey),"seventeenth stored-pending restoration rejected before registration");check(blockedRegistry.registrations.isEmpty()&&blockedRegistry.active.isEmpty()&&blockedRegistry.launches.isEmpty()&&blocked.restoredCount()==16&&blocked.savedKey()==null,"budget rejection registers no callback and obtains no authority");check(blockedRegistry.keyToRc.size()==18&&blockedRegistry.launchedKeys.size()==18&&blockedRegistry.keyToRc.keySet().stream().filter(k->k.startsWith("bwv-operation-")).count()==17&&blockedRegistry.keyToRc.containsKey("unrelated-capacitor")&&blockedRegistry.queued.containsKey(finalKey),"seventeenth app-owned inherited record plus unrelated mapping are observed, not falsely erased");check(originals.stream().allMatch(o->o.completed==0&&o.settled==0&&o.invalidated==1),"no orphan or rejected attempt resolves any original call");
   System.out.println("CHARACTERIZED: 16 admitted app-owned orphan residues + 1 inherited current record at rejected seventeenth restore; unrelated Capacitor mapping unchanged; no callback or owner authority installed by rejection.");
  });
  scenario("saved restoration count persists with no pending key and fresh Activity is zero",()->{
   Bridge fresh=new Bridge();check(fresh.activity.operations.restoredCount()==0,"fresh Activity counter zero");Bundle unrelated=new Bundle();unrelated.putString("other","value");expect(IllegalStateException.class,()->new Bridge(new ActivityResultRegistry(),unrelated),"non-null unrelated saved state missing counter rejects");expect(IllegalStateException.class,()->new Bridge(new ActivityResultRegistry(),new Bundle()),"empty non-null saved state missing counter rejects");
   for(int count:new int[]{0,1,15,16}){Bridge restored=new Bridge(new ActivityResultRegistry(),operationState(null,Integer.toString(count)));check(restored.activity.operations.restoredCount()==count&&restored.activity.operations.savedKey()==null,"no-key state retains exact restoration count");Bundle state=new Bundle();restored.activity.saveOperations(state);check(state.values.size()==2&&state.values.get("bwv.native.pendingOperationKey")==null&&Integer.toString(count).equals(state.values.get("bwv.native.restoredOperationCount")),"count persisted without pending operation");Bridge twice=new Bridge(new ActivityResultRegistry(),state);check(twice.activity.operations.restoredCount()==count,"null-key recreation does not increment counter");}
  });
  scenario("missing malformed and noncanonical state counts reject before registration",()->{
   String key="bwv-operation-11111111-1111-1111-1111-111111111111";
   for(String count:Arrays.asList(null,"","-1","+1","01","00"," 1","1 ","1.0","17","2147483648","١"))for(String pending:Arrays.asList(null,key)){
    ActivityResultRegistry registry=new ActivityResultRegistry();Bundle state=operationState(pending,count);expect(RuntimeException.class,()->new Bridge(registry,state),"malformed count "+count);check(registry.registrations.isEmpty()&&registry.active.isEmpty(),"malformed state is rejected before native registration");
   }
   for(String pending:Arrays.asList(null,key)){Bundle missing=new Bundle();missing.putString("bwv.native.pendingOperationKey",pending);ActivityResultRegistry registry=new ActivityResultRegistry();expect(IllegalStateException.class,()->new Bridge(registry,missing),"operation-key marker without count rejected");check(registry.registrations.isEmpty(),"missing counter cannot reset lineage budget");}
   Bundle wrongType=operationState(key,"1");wrongType.values.put("bwv.native.restoredOperationCount",1);ActivityResultRegistry registry=new ActivityResultRegistry();expect(RuntimeException.class,()->new Bridge(registry,wrongType),"non-string counter rejected");check(registry.registrations.isEmpty(),"non-string counter has no registration side effect");
  });
  scenario("valid restoration counts increment before dispatch and throwing registration",()->{
   String key="bwv-operation-11111111-1111-1111-1111-111111111111";
   ActivityResultRegistry synchronous=new ActivityResultRegistry();synchronous.queued.put(key,cancelled());MainActivityOperations operations=new MainActivityOperations(synchronous,15);operations.restore(key);check(operations.restoredCount()==16&&operations.savedKey()==null,"synchronous definitive restore still consumes budget");operations.restore(null);check(operations.restoredCount()==16,"subsequent null restore consumes none");
   ActivityResultRegistry throwing=new ActivityResultRegistry();throwing.failure=ActivityResultRegistry.Failure.REGISTER_BEFORE;MainActivityOperations failure=new MainActivityOperations(throwing,3);expect(IllegalStateException.class,()->failure.restore(key),"restore registration throws");check(failure.restoredCount()==4&&key.equals(failure.savedKey()),"registration failure conservatively consumes restoration and retains orphan slot");
   MainActivityOperations validation=new MainActivityOperations(new ActivityResultRegistry(),4);expect(IllegalStateException.class,()->validation.restore("not-a-native-key"),"invalid key rejected before budget");check(validation.restoredCount()==4,"invalid routing input does not consume restoration");validation.restore(key);expect(IllegalStateException.class,()->validation.restore(key),"occupied orphan cannot register again");check(validation.restoredCount()==5,"occupied-slot rejection does not consume a second restoration");
  });
  scenario("actual initialize and save slices preserve final allowed restore then reject next",()->{
   String key="bwv-operation-11111111-1111-1111-1111-111111111111";ActivityResultRegistry registry=new ActivityResultRegistry();registry.queued.put(key,cancelled());Bridge restored=new Bridge(registry,operationState(key,"15"));check(restored.activity.operations.restoredCount()==16&&restored.activity.operations.savedKey()==null,"actual initialization admits sixteenth stored-pending orphan");Bundle state=new Bundle();restored.activity.saveOperations(state);check("16".equals(state.values.get("bwv.native.restoredOperationCount"))&&state.values.get("bwv.native.pendingOperationKey")==null,"actual saved state retains exhaustion after orphan is consumed");Bridge noKey=new Bridge(new ActivityResultRegistry(),state);check(noKey.activity.operations.restoredCount()==16,"exhausted count survives empty-pending recreation");
   ActivityResultRegistry blocked=new ActivityResultRegistry();expect(IllegalStateException.class,()->new Bridge(blocked,operationState(key,"16")),"actual initialization rejects next restored key");check(blocked.registrations.isEmpty()&&blocked.active.isEmpty(),"exhausted Activity initialization cannot bind any result owner");
  });
 }
