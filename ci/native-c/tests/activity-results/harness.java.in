package io.github.sen2maker.buildingwebviewer;
import android.app.Activity;
import android.content.*;
import android.net.Uri;
import android.os.Bundle;
import android.os.Looper;
import androidx.activity.result.*;
import com.getcapacitor.BwvBridgeCallGuard;
import bwv.diagnostics.DiagnosticExportLease;
import java.io.*;
import java.util.*;
import java.util.concurrent.ConcurrentLinkedQueue;

/** Host-only tests of unchanged production fragments and full production coordinator. */
public final class MainActivityResultRegression {
 static final Thread UI=Thread.currentThread();
 static final String PROJECT_A="11111111-1111-1111-1111-111111111111",PROJECT_B="22222222-2222-2222-2222-222222222222";
 static final String RUN="selftest-11111111-1111-1111-1111-111111111111";
 static int checks,cases;
 static void check(boolean ok,String message){checks++;if(!ok)throw new AssertionError(message);}
 static void scenario(String name,Throwing task)throws Exception{int before=checks;task.run();android.os.Handler.drain();cases++;System.out.println("PASS "+name+" ("+(checks-before)+" assertions)");}
 @FunctionalInterface interface Throwing{void run()throws Exception;}
 static <T extends Throwable>T expect(Class<T> type,Throwing task,String message){try{task.run();}catch(Throwable t){check(type.isInstance(t),message+": wrong exception "+t);return type.cast(t);}throw new AssertionError(message+": did not throw");}
 static void worker(Throwing task)throws Exception{Throwable[] failure={null};Thread thread=new Thread(()->{try{task.run();}catch(Throwable t){failure[0]=t;}},"deterministic-io");thread.start();thread.join();if(failure[0]!=null){if(failure[0] instanceof Exception)throw (Exception)failure[0];throw new AssertionError(failure[0]);}}
 static final class QueueHandler {
  final Queue<Runnable> jobs=new ConcurrentLinkedQueue<>();
  void execute(Runnable r){jobs.add(r);}void post(Runnable r){jobs.add(r);}
  int size(){return jobs.size();}void drain(){Runnable r;while((r=jobs.poll())!=null)r.run();}
 }
 static final class JSONObject {
  final Map<String,Object> values=new LinkedHashMap<>();
  JSONObject put(String key,Object value){values.put(key,value);return this;}
  String getString(String key){return (String)values.get(key);}
  JSONArray getJSONArray(String key){return (JSONArray)values.get(key);}
 }
 static final class JSONArray {
  final List<String> values=new ArrayList<>();
  JSONArray(){}JSONArray(String text){if(text.length()>2)for(String value:text.substring(1,text.length()-1).split(","))values.add(value.substring(1,value.length()-1));}
  JSONArray put(String text){values.add(text);return this;}int length(){return values.size();}
  @Override public String toString(){return "["+String.join(",",values.stream().map(v->"\""+v+"\"").toList())+"]";}
 }
 static final class JSObject {
  final Map<String,Object> values=new LinkedHashMap<>();
  JSObject put(String key,Object value){values.put(key,value);return this;}
  static JSObject fromJSONObject(JSONObject object){JSObject value=new JSObject();value.values.putAll(object.values);return value;}
 }
 static final class PluginCall {
  final Bridge bridge;final String callbackId,plugin,method;final JSONObject data=new JSONObject();
  int resolved,rejected,released,delivered;JSObject result;String error;boolean failResolve;
  PluginCall(Bridge bridge,String callbackId,String plugin,String method){this.bridge=bridge;this.callbackId=callbackId;this.plugin=plugin;this.method=method;}
  String getString(String key){return data.getString(key);}String getString(String key,String fallback){String value=getString(key);return value==null?fallback:value;}
  JSONObject getData(){return data;}String getCallbackId(){return callbackId;}
  void release(Bridge ignored){released++;}
  void resolve(JSObject value){if(failResolve)throw new IllegalStateException("synthetic reply provider failure");resolved++;result=value;if(BwvBridgeCallGuard.current(this,bridge.webView))delivered++;}
  void resolve(){resolve(new JSObject());}
  void reject(String message){rejected++;error=message;}
  void reject(String message,Exception cause){reject(message);}
 }
 static final class WebView {
  String url;WebView(String url){this.url=url;}
  String getUrl(){if(Thread.currentThread()!=UI)throw new AssertionError("Live WebView read off UI");return url;}
 }
 static final class Bridge {
  final WebView webView=new WebView("https://localhost/assets/mobile/index.html");
  final QueueHandler ui=new QueueHandler();final BwvApplication application=new BwvApplication();
  MainActivity activity;String nonce;final BWVProjectsPlugin projects;final BWVSelfTestPlugin reports;
  Bridge(){this(new ActivityResultRegistry(),null);}
  Bridge(ActivityResultRegistry registry,Bundle state){activity=new MainActivity(this,registry,state);projects=new BWVProjectsPlugin(this);reports=new BWVSelfTestPlugin(this);navigate(webView.url);}
  WebView getWebView(){return webView;}String getLocalUrl(){return "https://localhost";}
  void navigate(String url){activity.invalidateOperations();webView.url=url;BwvBridgeCallGuard.documentStarted(webView,url);nonce=BwvBridgeCallGuard.authorizeDocument(webView,url);}
  void reload(){navigate(webView.url);}void diagnosticPage(){navigate("https://localhost/assets/mobile/self-test.html");}
  PluginCall call(String id,String method){String plugin=method.equals("exportReport")?"BWVSelfTest":"BWVProjects";PluginCall call=new PluginCall(this,id,plugin,method);check(BwvBridgeCallGuard.register(call,webView,"https://localhost","https://localhost",webView.url,true,plugin,method,nonce),"register actual provenance "+method);call.data.put("id",PROJECT_A).put("keys",new JSONArray()).put("lang","zh").put("runId",RUN).put("text","{\"report\":true}");return call;}
  void drainUi(){ui.drain();}
 }
 static final class StartupDiagnostics{final List<String> events=new ArrayList<>();void record(String code,String detail){events.add(code+":"+detail);}}
 static final class MainActivity extends Activity {
  final Bridge bridge;final ActivityResultRegistry registry;final StartupDiagnostics diagnostics=new StartupDiagnostics();
  boolean recovering,finishing,destroyed;
  @@ACTIVITY_FIELDS@@
  MainActivity(Bridge bridge,ActivityResultRegistry registry,Bundle state){this.bridge=bridge;this.registry=registry;initializeOperations(state);}
  ActivityResultRegistry getActivityResultRegistry(){return registry;}
  @Override public Object getApplication(){return bridge.application;}
  @Override public boolean isFinishing(){return finishing;}
  @Override public boolean isDestroyed(){return destroyed;}
  @Override public void runOnUiThread(Runnable task){if(Thread.currentThread()==UI)task.run();else bridge.ui.post(task);}
  void startActivity(Intent intent){finishing=true;}void finish(){finishing=true;}
  @@ACTIVITY_RECOVERY@@
  @@ACTIVITY_INITIALIZE@@
  @@ACTIVITY_LAUNCH@@
  @@ACTIVITY_INVALIDATE@@
  @@ACTIVITY_SAVE@@
  @@ACTIVITY_CLOSE@@
 }
 static final class ProcessRuntime{int checks;void assertBound(){checks++;}}
 static final class BwvApplication{final ProcessRuntime runtime=new ProcessRuntime();final NativeDiagnosticService diagnostics=new NativeDiagnosticService();ProcessRuntime runtime(){return runtime;}}
 static final class BuildConfig{static final boolean DIAGNOSTIC_ENABLED=true;}
 static final class Store {
  final List<String> imports=new ArrayList<>(),gets=new ArrayList<>();Runnable duringImport;boolean rejectGet;
  JSONObject get(String id){if(rejectGet)throw new IllegalStateException("unknown project");gets.add(id);return new JSONObject();}
  JSONObject importUris(String id,List<Uri> uris){imports.add(id+":"+uris.stream().map(Uri::value).toList());if(duringImport!=null)duringImport.run();return new JSONObject().put("id",id);}
 }
 static final class NativeGaussianActivity {static void authorizedFiles(Store store,String project,JSONArray keys){store.get(project);}}
 static final class RecoveryActivity{}
 static final class NativeDiagnosticService {
  final DiagnosticExportLease exports=new DiagnosticExportLease();final QueueHandler io=new QueueHandler();
  int reserveCount;DiagnosticExportLease.Export lastExport;
  DiagnosticExportLease.Export reserveExport(String run,String text)throws Exception{reserveCount++;lastExport=exports.reserve(run,text.getBytes(java.nio.charset.StandardCharsets.UTF_8));return lastExport;}
  @@SERVICE_FINISH@@
 }
 static final class DiagnosticReportSaveActivity extends Activity {
  final Handler handler=new Handler();final Runnable observe=()->{};NativeDiagnosticService service;String token;boolean finishing;
  @Override public boolean isFinishing(){return finishing;}
  @@REPORT_DESTROY@@
 }
 static final class Handler{void removeCallbacks(Runnable r){}}
 static final class BWVProjectsPlugin {
  final Bridge bridge;final ProcessRuntime runtime=new ProcessRuntime();final Store store=new Store();final QueueHandler IO=new QueueHandler();boolean destroyed;
  BWVProjectsPlugin(Bridge bridge){this.bridge=bridge;}Activity getActivity(){return bridge.activity;}Object getContext(){return bridge.activity;}
  interface Task{JSONObject run()throws Exception;}
  @@PROJECT_AUTHORIZED@@
  @@PROJECT_RUN@@
  @@PROJECT_PICK@@
  @@PROJECT_PICKED@@
  @@PROJECT_GAUSSIAN@@
  @@PROJECT_RETURNED@@
  @@PROJECT_URIS@@
 }
 static final class BWVSelfTestPlugin {
  final Bridge bridge;NativeDiagnosticService service;boolean destroyed;
  BWVSelfTestPlugin(Bridge bridge){this.bridge=bridge;service=bridge.application.diagnostics;}
  Activity getActivity(){return bridge.activity;}
  @@REPORT_GATE@@
  @@REPORT_RUN_ID@@
  @@REPORT_EXPORT@@
  @@REPORT_SAVED@@
 }
 static final class Owner implements MainActivityOperations.Owner {
  int completed,invalidated,settled;ActivityResult result;Runnable onComplete;boolean throwComplete,throwInvalidated,throwSettled;
  @Override public void complete(ActivityResult result){completed++;this.result=result;if(onComplete!=null)onComplete.run();if(throwComplete)throw new IllegalStateException("owner completion failed");}
  @Override public void invalidated(){invalidated++;if(throwInvalidated)throw new IllegalStateException("invalidated callback failed");}
  @Override public void settled(){settled++;if(throwSettled)throw new IllegalStateException("settled callback failed");}
 }
 static ActivityResult picked(String file){return new ActivityResult(Activity.RESULT_OK,new Intent().setData(Uri.parse("content://"+file)));}
 static ActivityResult cancelled(){return new ActivityResult(Activity.RESULT_CANCELED,null);}
 static ActivityResult gaussian(boolean compatibility){return new ActivityResult(Activity.RESULT_OK,new Intent().putExtra("compatibility",compatibility));}
 static ActivityResult saved(boolean success){return new ActivityResult(success?Activity.RESULT_OK:Activity.RESULT_CANCELED,new Intent());}
 static void assertLease(Bridge bridge,boolean busy,String why){check(bridge.reports.service.exports.busy()==busy,why);}
 static void startGaussian(Bridge bridge,PluginCall call)throws Exception{bridge.projects.openNativeGaussian(call);worker(bridge.projects.IO::drain);bridge.drainUi();}
 @@TEST_CASES@@
 public static void main(String[] arguments)throws Exception{check(Looper.myLooper()==Looper.getMainLooper(),"initialize UI thread identity");coordinatorTests();registryOrderTests();pluginTests();restoreBudgetTests();System.out.println("TOTAL: "+cases+" scenarios / "+checks+" assertions passed. Host-only deterministic doubles, not Android SDK/device acceptance.");}
}
